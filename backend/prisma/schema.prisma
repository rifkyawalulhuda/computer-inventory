generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id          Int      @id @default(autoincrement())
  code        String   @unique @map("site_code") @db.VarChar(5)
  siteName    String   @map("site_name") @db.VarChar(30)
  address     String   @db.Text
  phoneNumber String   @map("phone_number") @db.VarChar(30)
  devices     Device[]
  users       MasterUser[]
  jobCodes    DepartmentJobCode[]
  requestedDeviceChangeRequests DeviceChangeRequest[] @relation("DeviceChangeRequestRequestedDepartment")
  targetDeviceChangeRequests    DeviceChangeRequest[] @relation("DeviceChangeRequestTargetDepartment")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model DepartmentJobCode {
  id           Int        @id @default(autoincrement())
  departmentId Int        @map("department_id")
  code         String     @unique @map("job_code") @db.VarChar(15)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  devices      Device[]
  requestedDeviceChangeRequests DeviceChangeRequest[] @relation("DeviceChangeRequestRequestedJobCode")
  targetDeviceChangeRequests    DeviceChangeRequest[] @relation("DeviceChangeRequestTargetJobCode")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([departmentId], map: "idx_department_job_codes_department_id")
  @@map("department_job_codes")
}

model MasterUser {
  id           String  @id @default(cuid())
  name         String  @db.VarChar(100)
  role         String  @default("user") @db.VarChar(20)
  email        String  @unique @db.VarChar(191)
  passwordHash String  @map("password_hash") @db.VarChar(255)
  contact      String  @db.VarChar(50)
  rank         String  @db.VarChar(50)
  jobCodeId    Int     @map("site_code_id")

  jobCode Department @relation(fields: [jobCodeId], references: [id], onDelete: Restrict)
  submittedDeviceChangeRequests DeviceChangeRequest[] @relation("DeviceChangeRequestRequestedByUser")
  reviewingDeviceChangeRequests DeviceChangeRequest[] @relation("DeviceChangeRequestCurrentReviewer")
  targetPicDeviceChangeRequests DeviceChangeRequest[] @relation("DeviceChangeRequestTargetPicUser")
  deviceChangeRequestEvents     DeviceChangeRequestEvent[] @relation("DeviceChangeRequestEventActorUser")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([jobCodeId], map: "idx_master_users_site_code_id")
  @@map("master_users")
}

model Location {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  devices Device[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("locations")
}

model DeviceCategory {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  devices Device[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("device_categories")
}

model DeviceModel {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  devices Device[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("device_models")
}

model Employee {
  id         String             @id @default(cuid())
  fullName   String             @map("full_name")
  email      String?            @unique
  assignments DeviceAssignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employees")
}

model Device {
  id            String  @id @default(cuid())
  legacyNo      Int?    @map("legacy_no")
  pomsSiteCodeSystem String? @map("poms_site_code_system") @db.VarChar(5)
  serialNumber  String? @unique @map("serial_number")
  hostName      String? @map("host_name")
  userNameRaw   String? @map("user_name_raw")
  userEmailRaw  String? @map("user_email_raw")
  locationRaw   String? @map("location_raw")
  ipListRaw     String? @map("ip_list_raw")
  picNameRaw    String? @map("pic_name_raw")
  notes         String? @db.Text
  bitlockerKey  String? @map("bitlocker_key") @db.Text
  flowStatus    String  @default("APPROVED") @map("flow_status") @db.VarChar(30)
  flowAssignedPicUserId String?   @map("flow_assigned_pic_user_id")
  flowApprovedByUserId  String?   @map("flow_approved_by_user_id")
  flowApprovedAt        DateTime? @map("flow_approved_at")
  flowRejectedByUserId  String?   @map("flow_rejected_by_user_id")
  flowRejectedAt        DateTime? @map("flow_rejected_at")
  flowRejectNote        String?   @map("flow_reject_note") @db.Text
  flowRecipientSignature String?  @map("flow_recipient_signature") @db.Text
  flowSenderSignature    String?  @map("flow_sender_signature") @db.Text
  flowSenderSignedByUserId String? @map("flow_sender_signed_by_user_id")
  flowSenderSignedAt     DateTime? @map("flow_sender_signed_at")
  flowSubmittedByUserId  String?   @map("flow_submitted_by_user_id")

  jobCodeId            Int? @map("site_code_id")
  departmentJobCodeId  Int? @map("department_job_code_id")
  categoryId           Int? @map("category_id")
  modelId              Int? @map("model_id")
  locationId           Int? @map("location_id")

  jobCode            Department?        @relation(fields: [jobCodeId], references: [id], onDelete: SetNull)
  departmentJobCode  DepartmentJobCode? @relation(fields: [departmentJobCodeId], references: [id], onDelete: SetNull)
  category           DeviceCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  model              DeviceModel?       @relation(fields: [modelId], references: [id], onDelete: SetNull)
  location           Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)

  ipAddresses          DeviceIp[]
  assignments          DeviceAssignment[]
  leaseContracts       LeaseContract[]
  remoteAccessProfiles RemoteAccessProfile[]
  changeRequests       DeviceChangeRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hostName], map: "idx_devices_host_name")
  @@index([locationId], map: "idx_devices_location_id")
  @@index([categoryId], map: "idx_devices_category_id")
  @@index([departmentJobCodeId], map: "idx_devices_department_job_code_id")
  @@index([flowStatus], map: "idx_devices_flow_status")
  @@map("devices")
}

model DeviceChangeRequest {
  id                           String  @id @default(cuid())
  deviceId                     String  @map("device_id")
  requestType                  String  @map("request_type") @db.VarChar(40)
  status                       String  @db.VarChar(20)
  currentStep                  String  @map("current_step") @db.VarChar(40)
  requestedByUserId            String  @map("requested_by_user_id")
  requestedByDepartmentId      Int?    @map("requested_by_department_id")
  requestedNote                String  @map("requested_note") @db.Text
  requestedDepartmentJobCodeId Int?    @map("requested_department_job_code_id")
  targetDepartmentId           Int?    @map("target_department_id")
  targetPicUserId              String? @map("target_pic_user_id")
  targetDepartmentJobCodeId    Int?    @map("target_department_job_code_id")
  latestRejectReason           String? @map("latest_reject_reason") @db.Text
  currentReviewerUserId        String? @map("current_reviewer_user_id")
  approvedAt                   DateTime? @map("approved_at")
  rejectedAt                   DateTime? @map("rejected_at")

  device                    Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requestedByUser           MasterUser         @relation("DeviceChangeRequestRequestedByUser", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  currentReviewerUser       MasterUser?        @relation("DeviceChangeRequestCurrentReviewer", fields: [currentReviewerUserId], references: [id], onDelete: SetNull)
  targetPicUser             MasterUser?        @relation("DeviceChangeRequestTargetPicUser", fields: [targetPicUserId], references: [id], onDelete: SetNull)
  requestedByDepartment     Department?        @relation("DeviceChangeRequestRequestedDepartment", fields: [requestedByDepartmentId], references: [id], onDelete: SetNull)
  targetDepartment          Department?        @relation("DeviceChangeRequestTargetDepartment", fields: [targetDepartmentId], references: [id], onDelete: SetNull)
  requestedDepartmentJobCode DepartmentJobCode? @relation("DeviceChangeRequestRequestedJobCode", fields: [requestedDepartmentJobCodeId], references: [id], onDelete: SetNull)
  targetDepartmentJobCode   DepartmentJobCode? @relation("DeviceChangeRequestTargetJobCode", fields: [targetDepartmentJobCodeId], references: [id], onDelete: SetNull)
  events                    DeviceChangeRequestEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([deviceId], map: "idx_device_change_requests_device_id")
  @@index([status], map: "idx_device_change_requests_status")
  @@index([currentStep], map: "idx_device_change_requests_current_step")
  @@index([requestedByUserId], map: "idx_device_change_requests_requested_by_user_id")
  @@index([currentReviewerUserId], map: "idx_device_change_requests_current_reviewer_user_id")
  @@index([targetPicUserId], map: "idx_device_change_requests_target_pic_user_id")
  @@map("device_change_requests")
}

model DeviceChangeRequestEvent {
  id          String  @id @default(cuid())
  requestId    String  @map("request_id")
  actorUserId  String? @map("actor_user_id")
  action       String  @db.VarChar(60)
  note         String? @db.Text
  metadataJson Json?   @map("metadata_json")

  request   DeviceChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorUser MasterUser?         @relation("DeviceChangeRequestEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([requestId], map: "idx_device_change_request_events_request_id")
  @@index([actorUserId], map: "idx_device_change_request_events_actor_user_id")
  @@map("device_change_request_events")
}

model DeviceIp {
  id        Int    @id @default(autoincrement())
  deviceId  String @map("device_id")
  ipAddress String @map("ip_address")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([deviceId, ipAddress])
  @@index([ipAddress], map: "idx_device_ips_ip_address")
  @@map("device_ips")
}

model DeviceAssignment {
  id            String   @id @default(cuid())
  deviceId      String   @map("device_id")
  employeeId    String?  @map("employee_id")
  assignedName  String?  @map("assigned_name")
  assignedEmail String?  @map("assigned_email")
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  isActive      Boolean  @default(true) @map("is_active")
  notes         String?  @db.Text

  device   Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([deviceId, isActive], map: "idx_assignments_device_active")
  @@map("device_assignments")
}

model LeaseContract {
  id          String    @id @default(cuid())
  deviceId    String    @map("device_id")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  daysLease   Int?      @map("days_lease")
  leaseStatus String?   @map("lease_status")
  historyLog  String?   @map("history_log") @db.Text

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([endDate], map: "idx_lease_contracts_end_date")
  @@index([leaseStatus], map: "idx_lease_contracts_lease_status")
  @@map("lease_contracts")
}

model RemoteAccessProfile {
  id                 String    @id @default(cuid())
  deviceId           String?   @map("device_id")
  warehouse          String?
  userName           String?   @map("user_name")
  deviceType         String?   @map("device_type")
  pcName             String?   @map("pc_name")
  teamviewerVersion  String?   @map("teamviewer_version")
  teamviewerId       String?   @map("teamviewer_id")
  unattendedPassword String?   @map("unattended_password")
  picName            String?   @map("pic_name")
  contact            String?
  remarks            String?
  sourceUpdatedOn    DateTime? @map("source_updated_on")

  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([pcName], map: "idx_remote_profiles_pc_name")
  @@index([teamviewerId], map: "idx_remote_profiles_teamviewer_id")
  @@map("remote_access_profiles")
}
